+const CACHE_MAGIC: &[u8; 8] = b"ZOKMC01\0";
+
+/// SHA-256 of the compiled program, set by the CLI from the program file (ZOK_PROGRAM_SHA256).
+fn program_digest() -> [u8; 32] {
+    let h = std::env::var("ZOK_PROGRAM_SHA256").expect("ZOK_PROGRAM_SHA256 not set: the matrix cache needs the program digest");
+    let mut d = [0u8; 32];
+    for i in 0..32 { d[i] = u8::from_str_radix(&h[2 * i..2 * i + 2], 16).expect("bad program digest"); }
+    d
+}
+
+/// Proof from constraint matrices stored once per circuit (file `cache`), written on the first call.
+fn fast_proof<'a, T: Field + ArkFieldExtensions, I: IntoIterator<Item = Statement<'a, T>>, R: Read, G: RngCore + CryptoRng>(
+    program: ProgIterator<'a, T, I>,
+    witness: Witness<T>,
+    proving_key: R,
+    rng: &mut G,
+    cache: &str,
+) -> Proof<T, G16> {
+    use ark_ff::{One, UniformRand};
+    type Fr<T> = <<T as ArkFieldExtensions>::ArkEngine as ark_ec::PairingEngine>::Fr;
+    let zt = std::time::Instant::now();
+    let inputs = program
+        .public_inputs_values(&witness)
+        .into_iter()
+        .map(|v| parse_fr::<T>(&v.into_ark()))
+        .collect::<Vec<_>>();
+    eprintln!("ZKT zok.public_inputs {:.6}", zt.elapsed().as_secs_f64());
+    let zt = std::time::Instant::now();
+    let pk = ProvingKey::<<T as ArkFieldExtensions>::ArkEngine>::deserialize_unchecked(proving_key).unwrap();
+    eprintln!("ZKT zok.pk_deserialize {:.6}", zt.elapsed().as_secs_f64());
+    let zt = std::time::Instant::now();
+    let path = std::path::Path::new(cache);
+    let (flat, vars) = if path.exists() {
+        let mut r = std::io::BufReader::new(std::fs::File::open(path).unwrap());
+        let mut head = [0u8; 40];
+        r.read_exact(&mut head).unwrap();
+        if &head[..8] != CACHE_MAGIC || head[8..] != program_digest()[..] {
+            eprintln!("Error: the matrix cache {} was not written for this compiled program; run setup again with ZOK_MATRIX_CACHE set.", cache);
+            std::process::exit(1);
+        }
+        let flat = ark_groth16::fast::FlatR1cs::<Fr<T>>::read(&mut r).unwrap();
+        let mut b8 = [0u8; 8];
+        r.read_exact(&mut b8).unwrap();
+        let nv = u64::from_le_bytes(b8) as usize;
+        let mut buf = vec![0u8; 8 * nv];
+        r.read_exact(&mut buf).unwrap();
+        let vars = (0..nv)
+            .map(|i| zokrates_ast::common::flat::Variable { id: i64::from_le_bytes(buf[8 * i..8 * i + 8].try_into().unwrap()) as isize })
+            .collect::<Vec<_>>();
+        eprintln!("ZKT fast.load_matrices {:.6}", zt.elapsed().as_secs_f64());
+        (flat, vars)
+    } else {
+        let (flat, vars) = Computation::with_witness(program, witness.clone()).flat_prep();
+        eprintln!("ZKT fast.prep_synthesis {:.6}", zt.elapsed().as_secs_f64());
+        let zt = std::time::Instant::now();
+        write_cache(path, &flat, &vars);
+        eprintln!("ZKT fast.prep_write {:.6}", zt.elapsed().as_secs_f64());
+        (flat, vars)
+    };
+    let zt = std::time::Instant::now();
+    let z = vars
+        .iter()
+        .enumerate()
+        .map(|(i, v)| if i == 0 { Fr::<T>::one() } else { witness.0.get(v).unwrap().clone().into_ark() })
+        .collect::<Vec<_>>();
+    drop(witness);
+    eprintln!("ZKT fast.assignment {:.6}", zt.elapsed().as_secs_f64());
+    let r = Fr::<T>::rand(rng);
+    let s = Fr::<T>::rand(rng);
+    let proof = ark_groth16::fast::create_proof_flat(&pk, &flat, &z, r, s);
+    let proof_points = ProofPoints { a: parse_g1::<T>(&proof.a), b: parse_g2::<T>(&proof.b), c: parse_g1::<T>(&proof.c) };
+    Proof::new(proof_points, inputs)
+}
+
+fn write_cache<F: ark_ff::PrimeField>(path: &std::path::Path, flat: &ark_groth16::fast::FlatR1cs<F>, vars: &[zokrates_ast::common::flat::Variable]) {
+    use std::io::Write;
+    let mut w = std::io::BufWriter::new(std::fs::File::create(path).unwrap());
+    w.write_all(CACHE_MAGIC).unwrap();
+    w.write_all(&program_digest()).unwrap();
+    flat.write(&mut w).unwrap();
+    w.write_all(&(vars.len() as u64).to_le_bytes()).unwrap();
+    for v in vars { w.write_all(&(v.id as i64).to_le_bytes()).unwrap(); }
+    w.flush().unwrap();
+}
+
+/// Writes the matrix cache right after setup (no witness needed): synthesis in setup mode, then finalize and to_matrices.
+pub fn write_matrix_cache<'a, T: Field + ArkFieldExtensions, I: IntoIterator<Item = Statement<'a, T>>>(program: ProgIterator<'a, T, I>, cache: &str) {
+    let zt = std::time::Instant::now();
+    let (flat, vars) = Computation::without_witness(program).flat_prep();
+    eprintln!("ZKT setup.prep_synthesis {:.6}", zt.elapsed().as_secs_f64());
+    let zt = std::time::Instant::now();
+    write_cache(std::path::Path::new(cache), &flat, &vars);
+    eprintln!("ZKT setup.prep_write {:.6}", zt.elapsed().as_secs_f64());
+}
