+/// SHA-256 of the compiled program, handed to the back end so that a matrix cache is used only with the program it was written for.
+pub fn set_program_digest(path: &Path) -> Result<(), String> {
+    use sha2::{Digest, Sha256};
+    use std::io::Read;
+    if std::env::var("ZOK_MATRIX_CACHE").is_err() { return Ok(()); }
+    let zt = std::time::Instant::now();
+    let mut f = File::open(path).map_err(|why| format!("Couldn't open {}: {}", path.display(), why))?;
+    let mut h = Sha256::new();
+    let mut buf = vec![0u8; 1 << 20];
+    loop { let k = f.read(&mut buf).map_err(|e| e.to_string())?; if k == 0 { break; } h.update(&buf[..k]); }
+    std::env::set_var("ZOK_PROGRAM_SHA256", hex::encode(h.finalize()));
+    eprintln!("ZKT cli.program_digest {:.6}", zt.elapsed().as_secs_f64());
+    Ok(())
+}
