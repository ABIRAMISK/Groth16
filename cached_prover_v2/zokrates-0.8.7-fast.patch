+    /// Synthesizes once and returns the finalized constraint matrices in compact form, together with the
+    /// ZoKrates variable at every position of the full assignment (instance variables, then witness variables).
+    pub fn flat_prep(self) -> (ark_groth16::fast::FlatR1cs<<<T as ArkFieldExtensions>::ArkEngine as PairingEngine>::Fr>, Vec<Variable>) {
+        let setup = self.witness.is_none();
+        let cs = ConstraintSystem::<<<T as ArkFieldExtensions>::ArkEngine as PairingEngine>::Fr>::new_ref();
+        if setup { cs.set_mode(ark_relations::r1cs::SynthesisMode::Setup); }
+        cs.set_optimization_goal(ark_relations::r1cs::OptimizationGoal::Constraints);
+        let symbols = self.synthesize_into(cs.clone()).unwrap();
+        cs.finalize();
+        let m = cs.to_matrices().unwrap();
+        let ni = m.num_instance_variables;
+        let mut vars = vec![Variable::one(); ni + m.num_witness_variables];
+        for (v, av) in symbols {
+            match av {
+                ArkVariable::One => {}
+                ArkVariable::Instance(i) => vars[i] = v,
+                ArkVariable::Witness(j) => vars[ni + j] = v,
+                _ => panic!("unexpected variable kind"),
+            }
+        }
+        (ark_groth16::fast::FlatR1cs::from_matrices(&m), vars)
+    }
