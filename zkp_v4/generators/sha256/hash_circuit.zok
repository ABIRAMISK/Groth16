const u32[64] K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];

def rotr32<N>(u32 x) -> u32 {
    return (x >> N) | (x << (32 - N));
}

def extend(u32[64] w, u32 i) -> u32 {
    u32 s0 = rotr32::<7>(w[i-15]) ^ rotr32::<18>(w[i-15]) ^ (w[i-15] >> 3);
    u32 s1 = rotr32::<17>(w[i-2]) ^ rotr32::<19>(w[i-2]) ^ (w[i-2] >> 10);
    return w[i-16] + s0 + w[i-7] + s1;
}

def temp1(u32 e, u32 f, u32 g, u32 h, u32 k, u32 w) -> u32 {
    u32 ch = (e & f) ^ ((!e) & g);
    u32 S1 = rotr32::<6>(e) ^ rotr32::<11>(e) ^ rotr32::<25>(e);
    return h + S1 + ch + k + w;
}

def temp2(u32 a, u32 b, u32 c) -> u32 {
    u32 maj = (a & b) ^ (a & c) ^ (b & c);
    u32 S0 = rotr32::<2>(a) ^ rotr32::<13>(a) ^ rotr32::<22>(a);
    return S0 + maj;
}

def shaRound(u32[16] input, u32[8] current) -> u32[8] {
    u32 mut h0 = current[0];
    u32 mut h1 = current[1];
    u32 mut h2 = current[2];
    u32 mut h3 = current[3];
    u32 mut h4 = current[4];
    u32 mut h5 = current[5];
    u32 mut h6 = current[6];
    u32 mut h7 = current[7];
    u32[64] mut w = [...input, ...[0u32; 48]];
    for u32 i in 16..64 {
        w[i] = extend(w, i);
    }
    u32 mut a = h0;
    u32 mut b = h1;
    u32 mut c = h2;
    u32 mut d = h3;
    u32 mut e = h4;
    u32 mut f = h5;
    u32 mut g = h6;
    u32 mut h = h7;
    for u32 i in 0..64 {
        u32 t1 = temp1(e, f, g, h, K[i], w[i]);
        u32 t2 = temp2(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    h0 = h0 + a;
    h1 = h1 + b;
    h2 = h2 + c;
    h3 = h3 + d;
    h4 = h4 + e;
    h5 = h5 + f;
    h6 = h6 + g;
    h7 = h7 + h;
    return [h0, h1, h2, h3, h4, h5, h6, h7];
}

const u32[8] IV = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
];

def sha256_main<N>(u32[N][16] a) -> u32[8] {
    u32[8] mut current = IV;
    for u32 i in 0..N {
        current = shaRound(a[i], current);
    }
    return current;
}

// --- Helper Functions for Bit Conversion ---
def field_to_bits(field x) -> bool[254] {
    bool[254] mut bits = [false; 254];
    field mut tmp = x;
    for u32 i in 0..254 {
        field div = tmp / 2;
        // bit is 1 if tmp == 2*div + 1, else 0
        bits[i] = tmp == 2 * div + 1;
        tmp = div;
    }
    return bits;
}

def bits_to_u32_array(bool[512] bits) -> u32[16] {
    u32[16] mut words = [0u32; 16];
    for u32 i in 0..16 {
        u32 mut word = 0;
        for u32 j in 0..32 {
            word = word + (bits[i*32 + j] ? (1 << j) : 0);
        }
        words[i] = word;
    }
    return words;
}

def field_to_u32_array(field x) -> u32[16] {
    bool[254] bits_254 = field_to_bits(x);
    bool[512] mut bits_512 = [false; 512];
    for u32 i in 0..254 {
        bits_512[i] = bits_254[i];
    }
    return bits_to_u32_array(bits_512);
}

// --- Pedersen Commitment Function ---
def pedersen_commitment(field secret, field pubkey, field randomness) -> field {
    return secret * pubkey + randomness * 1;
}

// --- Main Circuit Function ---
def main(private field secret, public field pubkey, private field randomness, public u32[8] expected_hash) -> (field, u32) {
    field commitment = pedersen_commitment(secret, pubkey, randomness);
    u32[16] commitment_words = field_to_u32_array(commitment);
    u32[8] hash = sha256_main([commitment_words]);

    // Output commitment and first SHA256 word for debugging comparison
    return (commitment, hash[0]);
}




