    field D3c7 = m_D3_0_3_4 + m_D3_0_4_3 - 65535 * q3[3] - 1152921504606846975 * q3[4] + 75557863725914323353600;
    field D3c8 = m_D3_0_4_4 - 65535 * q3[4] + 4294901760;
