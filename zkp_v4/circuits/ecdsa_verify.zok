    field M2c5 = m_M2_0_1_4 + m_M2_0_2_3 + m_M2_0_3_2 + m_M2_0_4_1 - 65535 * q1[1] - 1152921504606846975 * q1[2] - 1152921504606846650 * q1[3] - 787512468624245691 * q1[4];
    field M2c6 = m_M2_0_2_4 + m_M2_0_3_3 + m_M2_0_4_2 - 65535 * q1[2] - 1152921504606846975 * q1[3] - 1152921504606846650 * q1[4];
    field M2c7 = m_M2_0_3_4 + m_M2_0_4_3 - 65535 * q1[3] - 1152921504606846975 * q1[4];
    field M2c8 = m_M2_0_4_4 - 65535 * q1[4];
    field M2s0 = M2c0 + 1152921504606846976 * M2c1 + 1329227995784915872903807060280344576 * M2c2;
    field M2t0 = M2s0 * INVG;
    field M2k0 = rc63(M2t0 + 4611686018427387904) - 4611686018427387904;
