    field m_M1_0_3_0 = (av[3]) * (wv[0]);
    field m_M1_0_3_1 = (av[3]) * (wv[1]);
    field m_M1_0_3_2 = (av[3]) * (wv[2]);
    field m_M1_0_3_3 = (av[3]) * (wv[3]);
    field m_M1_0_3_4 = (av[3]) * (wv[4]);
    field m_M1_0_4_0 = (av[4]) * (wv[0]);
    field m_M1_0_4_1 = (av[4]) * (wv[1]);
    field m_M1_0_4_2 = (av[4]) * (wv[2]);
    field m_M1_0_4_3 = (av[4]) * (wv[3]);
    field m_M1_0_4_4 = (av[4]) * (wv[4]);
    field M1c0 = m_M1_0_0_0 - (1) - 1140077614559805761 * q1[0] + 1140077614559805761;
    field M1c1 = m_M1_0_0_1 + m_M1_0_1_0 - (0) - 787512468624245691 * q1[0] - 1140077614559805761 * q1[1] + 787512468624245691;
    field M1c2 = m_M1_0_0_2 + m_M1_0_1_1 + m_M1_0_2_0 - (0) - 1152921504606846650 * q1[0] - 787512468624245691 * q1[1] - 1140077614559805761 * q1[2] + 1152921504606846650;
    field M1c3 = m_M1_0_0_3 + m_M1_0_1_2 + m_M1_0_2_1 + m_M1_0_3_0 - (0) - 1152921504606846975 * q1[0] - 1152921504606846650 * q1[1] - 787512468624245691 * q1[2] - 1140077614559805761 * q1[3] + 1152921504606846975;
    field M1c4 = m_M1_0_0_4 + m_M1_0_1_3 + m_M1_0_2_2 + m_M1_0_3_1 + m_M1_0_4_0 - (0) - 65535 * q1[0] - 1152921504606846975 * q1[1] - 1152921504606846650 * q1[2] - 787512468624245691 * q1[3] - 1140077614559805761 * q1[4] + 65535;
    field M1c5 = m_M1_0_1_4 + m_M1_0_2_3 + m_M1_0_3_2 + m_M1_0_4_1 - 65535 * q1[1] - 1152921504606846975 * q1[2] - 1152921504606846650 * q1[3] - 787512468624245691 * q1[4];
    field M1c6 = m_M1_0_2_4 + m_M1_0_3_3 + m_M1_0_4_2 - 65535 * q1[2] - 1152921504606846975 * q1[3] - 1152921504606846650 * q1[4];
    field M1c7 = m_M1_0_3_4 + m_M1_0_4_3 - 65535 * q1[3] - 1152921504606846975 * q1[4];
