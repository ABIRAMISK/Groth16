from "EMBED" import unpack as unpack_e;

const field INV_B = 3943513705650197338535533542649225978673840975594686247002332209588747560132;                  // 1 / 2^60
const field INVG = 14493258255508381488033508836155747960471331310026943194313024386007698821575;                  // 1 / 2^180
const field TOPM = 65535;                      // 2^16 - 1
const field LIMM = 1152921504606846975;                      // 2^60 - 1
