def padd(field[10] p1, field[10] p2, field[37] w) -> field[10] {
    field[5] lam = [rc60(w[0]), rc60(w[1]), rc60(w[2]), rc60(w[3]), rc16(w[4])];
    field[5] x3 = [rc60(w[5]), rc60(w[6]), rc60(w[7]), rc60(w[8]), rc16(w[9])];
    field[5] y3 = [rc60(w[10]), rc60(w[11]), rc60(w[12]), rc60(w[13]), rc16(w[14])];
    field[5] q1 = [rc60(w[15]), rc60(w[16]), rc60(w[17]), rc60(w[18]), rc18(w[19])];
    field[5] q2 = [rc60(w[20]), rc60(w[21]), rc60(w[22]), rc60(w[23]), rc17(w[24])];
    field[5] q3 = [rc60(w[25]), rc60(w[26]), rc60(w[27]), rc60(w[28]), rc18(w[29])];
    // identity A1  (q: 258 bits, carries [64, 64])
    field m_A1_0_0_0 = (lam[0]) * (p2[0] - p1[0]);
    field m_A1_0_0_1 = (lam[0]) * (p2[1] - p1[1]);
    field m_A1_0_0_2 = (lam[0]) * (p2[2] - p1[2]);
    field m_A1_0_0_3 = (lam[0]) * (p2[3] - p1[3]);
    field m_A1_0_0_4 = (lam[0]) * (p2[4] - p1[4]);
    field m_A1_0_1_0 = (lam[1]) * (p2[0] - p1[0]);
    field m_A1_0_1_1 = (lam[1]) * (p2[1] - p1[1]);
    field m_A1_0_1_2 = (lam[1]) * (p2[2] - p1[2]);
    field m_A1_0_1_3 = (lam[1]) * (p2[3] - p1[3]);
    field m_A1_0_1_4 = (lam[1]) * (p2[4] - p1[4]);
    field m_A1_0_2_0 = (lam[2]) * (p2[0] - p1[0]);
    field m_A1_0_2_1 = (lam[2]) * (p2[1] - p1[1]);
    field m_A1_0_2_2 = (lam[2]) * (p2[2] - p1[2]);
    field m_A1_0_2_3 = (lam[2]) * (p2[3] - p1[3]);
    field m_A1_0_2_4 = (lam[2]) * (p2[4] - p1[4]);
    field m_A1_0_3_0 = (lam[3]) * (p2[0] - p1[0]);
    field m_A1_0_3_1 = (lam[3]) * (p2[1] - p1[1]);
    field m_A1_0_3_2 = (lam[3]) * (p2[2] - p1[2]);
    field m_A1_0_3_3 = (lam[3]) * (p2[3] - p1[3]);
    field m_A1_0_3_4 = (lam[3]) * (p2[4] - p1[4]);
    field m_A1_0_4_0 = (lam[4]) * (p2[0] - p1[0]);
    field m_A1_0_4_1 = (lam[4]) * (p2[1] - p1[1]);
    field m_A1_0_4_2 = (lam[4]) * (p2[2] - p1[2]);
    field m_A1_0_4_3 = (lam[4]) * (p2[3] - p1[3]);
    field m_A1_0_4_4 = (lam[4]) * (p2[4] - p1[4]);
    field A1c0 = m_A1_0_0_0 - (p2[5] - p1[5]) - 1152921500311878703 * q1[0] + 4951761265099078634409389919;
    field A1c1 = m_A1_0_0_1 + m_A1_0_1_0 - (p2[6] - p1[6]) - 1152921504606846975 * q1[0] - 1152921500311878703 * q1[1] + 4951761283545831096191024175;
    field A1c2 = m_A1_0_0_2 + m_A1_0_1_1 + m_A1_0_2_0 - (p2[7] - p1[7]) - 1152921504606846975 * q1[0] - 1152921504606846975 * q1[1] - 1152921500311878703 * q1[2] + 4951761283545831096191024175;
    field A1c3 = m_A1_0_0_3 + m_A1_0_1_2 + m_A1_0_2_1 + m_A1_0_3_0 - (p2[8] - p1[8]) - 1152921504606846975 * q1[0] - 1152921504606846975 * q1[1] - 1152921504606846975 * q1[2] - 1152921500311878703 * q1[3] + 4951761283545831096191024175;
    field A1c4 = m_A1_0_0_4 + m_A1_0_1_3 + m_A1_0_2_2 + m_A1_0_3_1 + m_A1_0_4_0 - (p2[9] - p1[9]) - 65535 * q1[0] - 1152921504606846975 * q1[1] - 1152921504606846975 * q1[2] - 1152921504606846975 * q1[3] - 1152921500311878703 * q1[4] + 75557863725910028450863;
    field A1c5 = m_A1_0_1_4 + m_A1_0_2_3 + m_A1_0_3_2 + m_A1_0_4_1 - 65535 * q1[1] - 1152921504606846975 * q1[2] - 1152921504606846975 * q1[3] - 1152921504606846975 * q1[4] + 75557863725914323353600;
    field A1c6 = m_A1_0_2_4 + m_A1_0_3_3 + m_A1_0_4_2 - 65535 * q1[2] - 1152921504606846975 * q1[3] - 1152921504606846975 * q1[4] + 75557863725914323353600;
    field A1c7 = m_A1_0_3_4 + m_A1_0_4_3 - 65535 * q1[3] - 1152921504606846975 * q1[4] + 75557863725914323353600;
    field A1c8 = m_A1_0_4_4 - 65535 * q1[4] + 4294901760;
    field A1s0 = A1c0 + 1152921504606846976 * A1c1 + 1329227995784915872903807060280344576 * A1c2;
    field A1t0 = A1s0 * INVG;
    field A1k0 = rc64(A1t0 + 9223372036854775808) - 9223372036854775808;
    field A1s1 = A1c3 + 1152921504606846976 * A1c4 + 1329227995784915872903807060280344576 * A1c5 + A1k0;
    field A1t1 = A1s1 * INVG;
    field A1k1 = rc64(A1t1 + 9223372036854775808) - 9223372036854775808;
    field A1s2 = A1c6 + 1152921504606846976 * A1c7 + 1329227995784915872903807060280344576 * A1c8 + A1k1;
    assert(A1s2 == 0);
    // identity A2  (q: 257 bits, carries [63, 63])
    field m_A2_0_0_0 = (lam[0]) * (lam[0]);
    field m_A2_0_0_1 = (lam[0]) * (lam[1]);
    field m_A2_0_0_2 = (lam[0]) * (lam[2]);
    field m_A2_0_0_3 = (lam[0]) * (lam[3]);
    field m_A2_0_0_4 = (lam[0]) * (lam[4]);
    field m_A2_0_1_1 = (lam[1]) * (lam[1]);
    field m_A2_0_1_2 = (lam[1]) * (lam[2]);
    field m_A2_0_1_3 = (lam[1]) * (lam[3]);
    field m_A2_0_1_4 = (lam[1]) * (lam[4]);
    field m_A2_0_2_2 = (lam[2]) * (lam[2]);
    field m_A2_0_2_3 = (lam[2]) * (lam[3]);
