def modn_inv(field[5] av, field[10] w) -> field[5] {
    field[5] wv = [rc60(w[0]), rc60(w[1]), rc60(w[2]), rc60(w[3]), rc16(w[4])];
    field[5] q1 = [rc60(w[5]), rc60(w[6]), rc60(w[7]), rc60(w[8]), rc17(w[9])];
    // identity M1: av*wv = 1 (mod n)  (q: 257 bits, carries [63, 63])
    field m_M1_0_0_0 = (av[0]) * (wv[0]);
