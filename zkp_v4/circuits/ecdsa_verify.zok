    field M2t1 = M2s1 * INVG;
    field M2k1 = rc63(M2t1 + 4611686018427387904) - 4611686018427387904;
    field M2s2 = M2c6 + 1152921504606846976 * M2c7 + 1329227995784915872903807060280344576 * M2c8 + M2k1;
    assert(M2s2 == 0);
    return [...b4, ...b3, ...b2, ...b1, ...b0];
}

def rc256(field[5] v) -> field[5] {
    return [rc60(v[0]), rc60(v[1]), rc60(v[2]), rc60(v[3]), rc16(v[4])];
}

// v is canonical: its limbs 1..4 are not all ones, so v < 2^256 - 2^60 < p
def canon(field[5] v, field[1] w) -> bool {
    assert(((TOPM - v[4]) + (LIMM - v[3]) + (LIMM - v[2]) + (LIMM - v[1])) * w[0] == 1);
    return true;
}

// 1 <= v <= n - 1  (v + d = n - 1 with d >= 0 range-checked, and v != 0)
def rng_n(field[5] v, field[6] w) -> bool {
    field[5] d = [rc60(w[0]), rc60(w[1]), rc60(w[2]), rc60(w[3]), rc16(w[4])];
    field t0 = (v[0] + d[0] - NM1[0]) * INV_B;
    assert(t0 * (t0 - 1) == 0);
    field t1 = (v[1] + d[1] + t0 - NM1[1]) * INV_B;
    assert(t1 * (t1 - 1) == 0);
    field t2 = (v[2] + d[2] + t1 - NM1[2]) * INV_B;
    assert(t2 * (t2 - 1) == 0);
    field t3 = (v[3] + d[3] + t2 - NM1[3]) * INV_B;
    assert(t3 * (t3 - 1) == 0);
    assert(v[4] + d[4] + t3 - NM1[4] == 0);
    assert((v[0] + v[1] + v[2] + v[3] + v[4]) * w[5] == 1);
    return true;
}

// R.x mod n == r :  xr = r + b*n over the integers, b a bit
def final_cmp(field[5] xr, field[5] r, field[1] w) -> bool {
    field b = w[0];
    assert(b * (b - 1) == 0);
    field t0 = (xr[0] - r[0] - b * NN[0]) * INV_B;
    field u0 = rc2(t0 + 2) - 2;
    field t1 = (xr[1] - r[1] - b * NN[1] + u0) * INV_B;
    field u1 = rc2(t1 + 2) - 2;
    field t2 = (xr[2] - r[2] - b * NN[2] + u1) * INV_B;
    field u2 = rc2(t2 + 2) - 2;
    field t3 = (xr[3] - r[3] - b * NN[3] + u2) * INV_B;
    field u3 = rc2(t3 + 2) - 2;
    assert(xr[4] - r[4] - b * NN[4] + u3 == 0);
    return true;
}

// one of the 16 table entries  T[i][j] = i*G + j*Q + D'  chosen by the 2-bit digits (a1 a0) of u1 and (b1 b0) of u2
def sel16(bool a1, bool a0, bool b1, bool b0, field[120] tv) -> field[10] {
    field fa1 = if a1 { 1 } else { 0 }; field fa0 = if a0 { 1 } else { 0 };
    field fb1 = if b1 { 1 } else { 0 }; field fb0 = if b0 { 1 } else { 0 };
    field pa = fa1 * fa0; field pb = fb1 * fb0;
    field[4] oa = [1 - fa1 - fa0 + pa, fa0 - pa, fa1 - pa, pa];
    field[4] ob = [1 - fb1 - fb0 + pb, fb0 - pb, fb1 - pb, pb];
    field s00 = oa[0] * ob[0];
    field s01 = oa[0] * ob[1];
    field s02 = oa[0] * ob[2];
    field s03 = oa[0] * ob[3];
    field s10 = oa[1] * ob[0];
    field s11 = oa[1] * ob[1];
    field s12 = oa[1] * ob[2];
    field s13 = oa[1] * ob[3];
    field s20 = oa[2] * ob[0];
    field s21 = oa[2] * ob[1];
    field s22 = oa[2] * ob[2];
    field s23 = oa[2] * ob[3];
    field s30 = oa[3] * ob[0];
    field s31 = oa[3] * ob[1];
    field s32 = oa[3] * ob[2];
    field s33 = oa[3] * ob[3];
    field o0 = 14574042457051709 * s00 + 682497382682504113 * s10 + 1116919558671063553 * s20 + 616186894014025916 * s30 + s01 * tv[0] + s02 * tv[10] + s03 * tv[20] + s11 * tv[30] + s12 * tv[40] + s13 * tv[50] + s21 * tv[60] + s22 * tv[70] + s23 * tv[80] + s31 * tv[90] + s32 * tv[100] + s33 * tv[110];
    field o1 = 45755258170377552 * s00 + 372564039278455492 * s10 + 674947624140568110 * s20 + 818906883359214024 * s30 + s01 * tv[1] + s02 * tv[11] + s03 * tv[21] + s11 * tv[31] + s12 * tv[41] + s13 * tv[51] + s21 * tv[61] + s22 * tv[71] + s23 * tv[81] + s31 * tv[91] + s32 * tv[101] + s33 * tv[111];
    field o2 = 648729594531869947 * s00 + 873390345692702211 * s10 + 568124220029305604 * s20 + 942528193954288009 * s30 + s01 * tv[2] + s02 * tv[12] + s03 * tv[22] + s11 * tv[32] + s12 * tv[42] + s13 * tv[52] + s21 * tv[62] + s22 * tv[72] + s23 * tv[82] + s31 * tv[92] + s32 * tv[102] + s33 * tv[112];
    field o3 = 1126575233819461952 * s00 + 951286089328481107 * s10 + 106833163108916044 * s20 + 443150737703527200 * s30 + s01 * tv[3] + s02 * tv[13] + s03 * tv[23] + s11 * tv[33] + s12 * tv[43] + s13 * tv[53] + s21 * tv[63] + s22 * tv[73] + s23 * tv[83] + s31 * tv[93] + s32 * tv[103] + s33 * tv[113];
