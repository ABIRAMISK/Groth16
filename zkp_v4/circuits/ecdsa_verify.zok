// u = av*wv mod n; returns the 256 bits of u, most significant first (u is range-checked through its bits)
def modn_u(field[5] av, field[5] wv, field[10] w) -> bool[256] {
    bool[60] b0 = unpack_e(w[0]); assert((b0[0] ? 576460752303423488 : 0) + (b0[1] ? 288230376151711744 : 0) + (b0[2] ? 144115188075855872 : 0) + (b0[3] ? 72057594037927936 : 0) + (b0[4] ? 36028797018963968 : 0) + (b0[5] ? 18014398509481984 : 0) + (b0[6] ? 9007199254740992 : 0) + (b0[7] ? 4503599627370496 : 0) + (b0[8] ? 2251799813685248 : 0) + (b0[9] ? 1125899906842624 : 0) + (b0[10] ? 562949953421312 : 0) + (b0[11] ? 281474976710656 : 0) + (b0[12] ? 140737488355328 : 0) + (b0[13] ? 70368744177664 : 0) + (b0[14] ? 35184372088832 : 0) + (b0[15] ? 17592186044416 : 0) + (b0[16] ? 8796093022208 : 0) + (b0[17] ? 4398046511104 : 0) + (b0[18] ? 2199023255552 : 0) + (b0[19] ? 1099511627776 : 0) + (b0[20] ? 549755813888 : 0) + (b0[21] ? 274877906944 : 0) + (b0[22] ? 137438953472 : 0) + (b0[23] ? 68719476736 : 0) + (b0[24] ? 34359738368 : 0) + (b0[25] ? 17179869184 : 0) + (b0[26] ? 8589934592 : 0) + (b0[27] ? 4294967296 : 0) + (b0[28] ? 2147483648 : 0) + (b0[29] ? 1073741824 : 0) + (b0[30] ? 536870912 : 0) + (b0[31] ? 268435456 : 0) + (b0[32] ? 134217728 : 0) + (b0[33] ? 67108864 : 0) + (b0[34] ? 33554432 : 0) + (b0[35] ? 16777216 : 0) + (b0[36] ? 8388608 : 0) + (b0[37] ? 4194304 : 0) + (b0[38] ? 2097152 : 0) + (b0[39] ? 1048576 : 0) + (b0[40] ? 524288 : 0) + (b0[41] ? 262144 : 0) + (b0[42] ? 131072 : 0) + (b0[43] ? 65536 : 0) + (b0[44] ? 32768 : 0) + (b0[45] ? 16384 : 0) + (b0[46] ? 8192 : 0) + (b0[47] ? 4096 : 0) + (b0[48] ? 2048 : 0) + (b0[49] ? 1024 : 0) + (b0[50] ? 512 : 0) + (b0[51] ? 256 : 0) + (b0[52] ? 128 : 0) + (b0[53] ? 64 : 0) + (b0[54] ? 32 : 0) + (b0[55] ? 16 : 0) + (b0[56] ? 8 : 0) + (b0[57] ? 4 : 0) + (b0[58] ? 2 : 0) + (b0[59] ? 1 : 0) == w[0]);
    bool[60] b1 = unpack_e(w[1]); assert((b1[0] ? 576460752303423488 : 0) + (b1[1] ? 288230376151711744 : 0) + (b1[2] ? 144115188075855872 : 0) + (b1[3] ? 72057594037927936 : 0) + (b1[4] ? 36028797018963968 : 0) + (b1[5] ? 18014398509481984 : 0) + (b1[6] ? 9007199254740992 : 0) + (b1[7] ? 4503599627370496 : 0) + (b1[8] ? 2251799813685248 : 0) + (b1[9] ? 1125899906842624 : 0) + (b1[10] ? 562949953421312 : 0) + (b1[11] ? 281474976710656 : 0) + (b1[12] ? 140737488355328 : 0) + (b1[13] ? 70368744177664 : 0) + (b1[14] ? 35184372088832 : 0) + (b1[15] ? 17592186044416 : 0) + (b1[16] ? 8796093022208 : 0) + (b1[17] ? 4398046511104 : 0) + (b1[18] ? 2199023255552 : 0) + (b1[19] ? 1099511627776 : 0) + (b1[20] ? 549755813888 : 0) + (b1[21] ? 274877906944 : 0) + (b1[22] ? 137438953472 : 0) + (b1[23] ? 68719476736 : 0) + (b1[24] ? 34359738368 : 0) + (b1[25] ? 17179869184 : 0) + (b1[26] ? 8589934592 : 0) + (b1[27] ? 4294967296 : 0) + (b1[28] ? 2147483648 : 0) + (b1[29] ? 1073741824 : 0) + (b1[30] ? 536870912 : 0) + (b1[31] ? 268435456 : 0) + (b1[32] ? 134217728 : 0) + (b1[33] ? 67108864 : 0) + (b1[34] ? 33554432 : 0) + (b1[35] ? 16777216 : 0) + (b1[36] ? 8388608 : 0) + (b1[37] ? 4194304 : 0) + (b1[38] ? 2097152 : 0) + (b1[39] ? 1048576 : 0) + (b1[40] ? 524288 : 0) + (b1[41] ? 262144 : 0) + (b1[42] ? 131072 : 0) + (b1[43] ? 65536 : 0) + (b1[44] ? 32768 : 0) + (b1[45] ? 16384 : 0) + (b1[46] ? 8192 : 0) + (b1[47] ? 4096 : 0) + (b1[48] ? 2048 : 0) + (b1[49] ? 1024 : 0) + (b1[50] ? 512 : 0) + (b1[51] ? 256 : 0) + (b1[52] ? 128 : 0) + (b1[53] ? 64 : 0) + (b1[54] ? 32 : 0) + (b1[55] ? 16 : 0) + (b1[56] ? 8 : 0) + (b1[57] ? 4 : 0) + (b1[58] ? 2 : 0) + (b1[59] ? 1 : 0) == w[1]);
    bool[60] b2 = unpack_e(w[2]); assert((b2[0] ? 576460752303423488 : 0) + (b2[1] ? 288230376151711744 : 0) + (b2[2] ? 144115188075855872 : 0) + (b2[3] ? 72057594037927936 : 0) + (b2[4] ? 36028797018963968 : 0) + (b2[5] ? 18014398509481984 : 0) + (b2[6] ? 9007199254740992 : 0) + (b2[7] ? 4503599627370496 : 0) + (b2[8] ? 2251799813685248 : 0) + (b2[9] ? 1125899906842624 : 0) + (b2[10] ? 562949953421312 : 0) + (b2[11] ? 281474976710656 : 0) + (b2[12] ? 140737488355328 : 0) + (b2[13] ? 70368744177664 : 0) + (b2[14] ? 35184372088832 : 0) + (b2[15] ? 17592186044416 : 0) + (b2[16] ? 8796093022208 : 0) + (b2[17] ? 4398046511104 : 0) + (b2[18] ? 2199023255552 : 0) + (b2[19] ? 1099511627776 : 0) + (b2[20] ? 549755813888 : 0) + (b2[21] ? 274877906944 : 0) + (b2[22] ? 137438953472 : 0) + (b2[23] ? 68719476736 : 0) + (b2[24] ? 34359738368 : 0) + (b2[25] ? 17179869184 : 0) + (b2[26] ? 8589934592 : 0) + (b2[27] ? 4294967296 : 0) + (b2[28] ? 2147483648 : 0) + (b2[29] ? 1073741824 : 0) + (b2[30] ? 536870912 : 0) + (b2[31] ? 268435456 : 0) + (b2[32] ? 134217728 : 0) + (b2[33] ? 67108864 : 0) + (b2[34] ? 33554432 : 0) + (b2[35] ? 16777216 : 0) + (b2[36] ? 8388608 : 0) + (b2[37] ? 4194304 : 0) + (b2[38] ? 2097152 : 0) + (b2[39] ? 1048576 : 0) + (b2[40] ? 524288 : 0) + (b2[41] ? 262144 : 0) + (b2[42] ? 131072 : 0) + (b2[43] ? 65536 : 0) + (b2[44] ? 32768 : 0) + (b2[45] ? 16384 : 0) + (b2[46] ? 8192 : 0) + (b2[47] ? 4096 : 0) + (b2[48] ? 2048 : 0) + (b2[49] ? 1024 : 0) + (b2[50] ? 512 : 0) + (b2[51] ? 256 : 0) + (b2[52] ? 128 : 0) + (b2[53] ? 64 : 0) + (b2[54] ? 32 : 0) + (b2[55] ? 16 : 0) + (b2[56] ? 8 : 0) + (b2[57] ? 4 : 0) + (b2[58] ? 2 : 0) + (b2[59] ? 1 : 0) == w[2]);
    bool[60] b3 = unpack_e(w[3]); assert((b3[0] ? 576460752303423488 : 0) + (b3[1] ? 288230376151711744 : 0) + (b3[2] ? 144115188075855872 : 0) + (b3[3] ? 72057594037927936 : 0) + (b3[4] ? 36028797018963968 : 0) + (b3[5] ? 18014398509481984 : 0) + (b3[6] ? 9007199254740992 : 0) + (b3[7] ? 4503599627370496 : 0) + (b3[8] ? 2251799813685248 : 0) + (b3[9] ? 1125899906842624 : 0) + (b3[10] ? 562949953421312 : 0) + (b3[11] ? 281474976710656 : 0) + (b3[12] ? 140737488355328 : 0) + (b3[13] ? 70368744177664 : 0) + (b3[14] ? 35184372088832 : 0) + (b3[15] ? 17592186044416 : 0) + (b3[16] ? 8796093022208 : 0) + (b3[17] ? 4398046511104 : 0) + (b3[18] ? 2199023255552 : 0) + (b3[19] ? 1099511627776 : 0) + (b3[20] ? 549755813888 : 0) + (b3[21] ? 274877906944 : 0) + (b3[22] ? 137438953472 : 0) + (b3[23] ? 68719476736 : 0) + (b3[24] ? 34359738368 : 0) + (b3[25] ? 17179869184 : 0) + (b3[26] ? 8589934592 : 0) + (b3[27] ? 4294967296 : 0) + (b3[28] ? 2147483648 : 0) + (b3[29] ? 1073741824 : 0) + (b3[30] ? 536870912 : 0) + (b3[31] ? 268435456 : 0) + (b3[32] ? 134217728 : 0) + (b3[33] ? 67108864 : 0) + (b3[34] ? 33554432 : 0) + (b3[35] ? 16777216 : 0) + (b3[36] ? 8388608 : 0) + (b3[37] ? 4194304 : 0) + (b3[38] ? 2097152 : 0) + (b3[39] ? 1048576 : 0) + (b3[40] ? 524288 : 0) + (b3[41] ? 262144 : 0) + (b3[42] ? 131072 : 0) + (b3[43] ? 65536 : 0) + (b3[44] ? 32768 : 0) + (b3[45] ? 16384 : 0) + (b3[46] ? 8192 : 0) + (b3[47] ? 4096 : 0) + (b3[48] ? 2048 : 0) + (b3[49] ? 1024 : 0) + (b3[50] ? 512 : 0) + (b3[51] ? 256 : 0) + (b3[52] ? 128 : 0) + (b3[53] ? 64 : 0) + (b3[54] ? 32 : 0) + (b3[55] ? 16 : 0) + (b3[56] ? 8 : 0) + (b3[57] ? 4 : 0) + (b3[58] ? 2 : 0) + (b3[59] ? 1 : 0) == w[3]);
    bool[16] b4 = unpack_e(w[4]); assert((b4[0] ? 32768 : 0) + (b4[1] ? 16384 : 0) + (b4[2] ? 8192 : 0) + (b4[3] ? 4096 : 0) + (b4[4] ? 2048 : 0) + (b4[5] ? 1024 : 0) + (b4[6] ? 512 : 0) + (b4[7] ? 256 : 0) + (b4[8] ? 128 : 0) + (b4[9] ? 64 : 0) + (b4[10] ? 32 : 0) + (b4[11] ? 16 : 0) + (b4[12] ? 8 : 0) + (b4[13] ? 4 : 0) + (b4[14] ? 2 : 0) + (b4[15] ? 1 : 0) == w[4]);
    field[5] uv = [w[0], w[1], w[2], w[3], w[4]];
    field[5] q1 = [rc60(w[5]), rc60(w[6]), rc60(w[7]), rc60(w[8]), rc17(w[9])];
    // identity M2: av*wv - uv = 0 (mod n)  (q: 257 bits, carries [63, 63])
    field m_M2_0_0_0 = (av[0]) * (wv[0]);
    field m_M2_0_0_1 = (av[0]) * (wv[1]);
    field m_M2_0_0_2 = (av[0]) * (wv[2]);
    field m_M2_0_0_3 = (av[0]) * (wv[3]);
    field m_M2_0_0_4 = (av[0]) * (wv[4]);
    field m_M2_0_1_0 = (av[1]) * (wv[0]);
    field m_M2_0_1_1 = (av[1]) * (wv[1]);
    field m_M2_0_1_2 = (av[1]) * (wv[2]);
    field m_M2_0_1_3 = (av[1]) * (wv[3]);
    field m_M2_0_1_4 = (av[1]) * (wv[4]);
    field m_M2_0_2_0 = (av[2]) * (wv[0]);
    field m_M2_0_2_1 = (av[2]) * (wv[1]);
    field m_M2_0_2_2 = (av[2]) * (wv[2]);
    field m_M2_0_2_3 = (av[2]) * (wv[3]);
    field m_M2_0_2_4 = (av[2]) * (wv[4]);
    field m_M2_0_3_0 = (av[3]) * (wv[0]);
    field m_M2_0_3_1 = (av[3]) * (wv[1]);
    field m_M2_0_3_2 = (av[3]) * (wv[2]);
    field m_M2_0_3_3 = (av[3]) * (wv[3]);
    field m_M2_0_3_4 = (av[3]) * (wv[4]);
    field m_M2_0_4_0 = (av[4]) * (wv[0]);
    field m_M2_0_4_1 = (av[4]) * (wv[1]);
    field m_M2_0_4_2 = (av[4]) * (wv[2]);
    field m_M2_0_4_3 = (av[4]) * (wv[3]);
    field m_M2_0_4_4 = (av[4]) * (wv[4]);
    field M2c0 = m_M2_0_0_0 - (uv[0]) - 1140077614559805761 * q1[0] + 2280155229119611522;
    field M2c1 = m_M2_0_0_1 + m_M2_0_1_0 - (uv[1]) - 787512468624245691 * q1[0] - 1140077614559805761 * q1[1] + 1575024937248491382;
    field M2c2 = m_M2_0_0_2 + m_M2_0_1_1 + m_M2_0_2_0 - (uv[2]) - 1152921504606846650 * q1[0] - 787512468624245691 * q1[1] - 1140077614559805761 * q1[2] + 2305843009213693300;
    field M2c3 = m_M2_0_0_3 + m_M2_0_1_2 + m_M2_0_2_1 + m_M2_0_3_0 - (uv[3]) - 1152921504606846975 * q1[0] - 1152921504606846650 * q1[1] - 787512468624245691 * q1[2] - 1140077614559805761 * q1[3] + 2305843009213693950;
