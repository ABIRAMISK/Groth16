const field[10] C_G3 = [432892106279761657, 224199595875998472, 310614202149644725, 621524397633635475, 63792, 917042680326317682, 2983607683658166, 231906974834579045, 554213452508381438, 14479];
const field[10] C_E = [1058457680018711777, 460357756121397748, 522631058442987094, 719157907341100188, 61157, 4347881915417677, 191792147038927530, 608225377431544301, 154154644309860653, 25331];   // -((4^128 - 1)/3) * D'

// range checks: x in [0, 2^L)  (the assert on the recomposition keeps the bits in the circuit)
def rc2(field x) -> field {
    bool[2] b = unpack_e(x);
    assert((b[0] ? 2 : 0) + (b[1] ? 1 : 0) == x);
    return x;
}

def rc16(field x) -> field {
    bool[16] b = unpack_e(x);
    assert((b[0] ? 32768 : 0) + (b[1] ? 16384 : 0) + (b[2] ? 8192 : 0) + (b[3] ? 4096 : 0) + (b[4] ? 2048 : 0) + (b[5] ? 1024 : 0) + (b[6] ? 512 : 0) + (b[7] ? 256 : 0) + (b[8] ? 128 : 0) + (b[9] ? 64 : 0) + (b[10] ? 32 : 0) + (b[11] ? 16 : 0) + (b[12] ? 8 : 0) + (b[13] ? 4 : 0) + (b[14] ? 2 : 0) + (b[15] ? 1 : 0) == x);
    return x;
}

def rc17(field x) -> field {
    bool[17] b = unpack_e(x);
    assert((b[0] ? 65536 : 0) + (b[1] ? 32768 : 0) + (b[2] ? 16384 : 0) + (b[3] ? 8192 : 0) + (b[4] ? 4096 : 0) + (b[5] ? 2048 : 0) + (b[6] ? 1024 : 0) + (b[7] ? 512 : 0) + (b[8] ? 256 : 0) + (b[9] ? 128 : 0) + (b[10] ? 64 : 0) + (b[11] ? 32 : 0) + (b[12] ? 16 : 0) + (b[13] ? 8 : 0) + (b[14] ? 4 : 0) + (b[15] ? 2 : 0) + (b[16] ? 1 : 0) == x);
    return x;
}

def rc18(field x) -> field {
    bool[18] b = unpack_e(x);
    assert((b[0] ? 131072 : 0) + (b[1] ? 65536 : 0) + (b[2] ? 32768 : 0) + (b[3] ? 16384 : 0) + (b[4] ? 8192 : 0) + (b[5] ? 4096 : 0) + (b[6] ? 2048 : 0) + (b[7] ? 1024 : 0) + (b[8] ? 512 : 0) + (b[9] ? 256 : 0) + (b[10] ? 128 : 0) + (b[11] ? 64 : 0) + (b[12] ? 32 : 0) + (b[13] ? 16 : 0) + (b[14] ? 8 : 0) + (b[15] ? 4 : 0) + (b[16] ? 2 : 0) + (b[17] ? 1 : 0) == x);
    return x;
}

def rc19(field x) -> field {
    bool[19] b = unpack_e(x);
    assert((b[0] ? 262144 : 0) + (b[1] ? 131072 : 0) + (b[2] ? 65536 : 0) + (b[3] ? 32768 : 0) + (b[4] ? 16384 : 0) + (b[5] ? 8192 : 0) + (b[6] ? 4096 : 0) + (b[7] ? 2048 : 0) + (b[8] ? 1024 : 0) + (b[9] ? 512 : 0) + (b[10] ? 256 : 0) + (b[11] ? 128 : 0) + (b[12] ? 64 : 0) + (b[13] ? 32 : 0) + (b[14] ? 16 : 0) + (b[15] ? 8 : 0) + (b[16] ? 4 : 0) + (b[17] ? 2 : 0) + (b[18] ? 1 : 0) == x);
    return x;
}

